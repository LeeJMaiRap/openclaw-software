{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openclaw.ai/schemas/task.schema.json",
  "title": "OpenClaw AI Worker Task File",
  "description": "Schema for task files generated by LeeJ Agent and executed by worker agents.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "project",
    "goal",
    "acceptance_criteria",
    "constraints",
    "context_files",
    "worker",
    "priority",
    "timeout_minutes",
    "depends_on"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "description": "Unique task identifier.",
      "pattern": "^TASK-[0-9]{3,}$",
      "examples": [
        "TASK-001"
      ]
    },
    "project": {
      "type": "string",
      "description": "Project slug or name.",
      "minLength": 1,
      "examples": [
        "openclaw-ai"
      ]
    },
    "goal": {
      "type": "string",
      "description": "Clear, measurable goal for the worker.",
      "minLength": 10
    },
    "acceptance_criteria": {
      "type": "array",
      "description": "Concrete, testable criteria required for completion.",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 5
      }
    },
    "constraints": {
      "type": "array",
      "description": "Technical, scope, language, framework, or runtime constraints.",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "default": []
    },
    "context_files": {
      "type": "array",
      "description": "Relevant files the worker should read before executing.",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "default": []
    },
    "worker": {
      "type": "string",
      "description": "Worker adapter or runtime that should execute the task.",
      "enum": [
        "claude-cli",
        "codex-cli",
        "hermes",
        "openclaw-subagent",
        "manual"
      ]
    },
    "priority": {
      "type": "string",
      "description": "Task priority.",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "timeout_minutes": {
      "type": "integer",
      "description": "Maximum execution time for the worker.",
      "minimum": 1,
      "maximum": 1440
    },
    "depends_on": {
      "type": "array",
      "description": "Task IDs that must be completed before this task can be dispatched.",
      "items": {
        "type": "string",
        "pattern": "^TASK-[0-9]{3,}$"
      },
      "default": []
    },
    "batch_id": {
      "type": "string",
      "description": "Optional batch identifier for tasks created from the same large request.",
      "pattern": "^B-[0-9]{3,}$"
    }
  }
}
